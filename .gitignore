# ---------------------------------------------------------------------------
# LaTeX build products — regenerated by `latexmk -pdf main.tex`.
# Nothing in this list belongs in the repository.
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.log
*.out
*.ps
*.run.xml
*.synctex
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.xdv
*.spl
*.bbl-SAVE-ERROR

# Build directories (e.g. `latexmk -outdir=build`, Overleaf-style output)
latex/build/
build/

# latexindent and editor temporary files
__latexindent_temp.tex
.latexmk*
*.bbl.bak
*.tex.bak

# ---------------------------------------------------------------------------
# Editor / Word temporary files
# ---------------------------------------------------------------------------
~$*
*.bak
*.tmp

# OS clutter
.DS_Store
Thumbs.db

# Note: latex/main.pdf is the rendered manuscript and is deliberately tracked
# (it is a deliverable, not an intermediate file). To stop tracking it:
#   git rm --cached latex/main.pdf
# and un-comment the next line.
# latex/main.pdf
